#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/lib" && pwd)"
# shellcheck source=lib/selection.sh
source "$LIB_DIR/selection.sh"

show_help() {
	local bind=T
	if [[ -n $TMUX ]]; then
		bind=$(tmux show-option -gvq '@t-bind')
		bind=${bind:-T}
	fi
	printf '\n  t - session/workspace picker\n\n'
	printf '  t                  Open interactive picker\n'
	printf '  t {name|path}      Resolve a zoxide name or local path in the initial mode\n'
	printf '  t -h | --help      Show help\n\n'
	printf '  TMUX set: locked Tmux Mode; <prefix>+%s opens the popup\n' "$bind"
	printf '  Otherwise: Herdr Mode (stub), ctrl-g switches to/from Tmux Mode\n'
	printf '  tab/shift-tab navigate; mode switching resets the query and cursor\n'
	printf '  Herdr stub only previews commands; no Herdr calls or server startup\n'
	printf '  Direct input skips fzf; outside tmux it only previews a stub command\n'
	printf '  Repository cloning is not supported\n\n'
}

load_backend() {
	unset -f list_options picker_settings open_selection
	case $MODE in
	tmux)
		# shellcheck source=lib/tmux.sh
		source "$LIB_DIR/tmux.sh"
		;;
	herdr)
		# shellcheck source=lib/herdr.sh
		source "$LIB_DIR/herdr.sh"
		;;
	esac
}

open_input() {
	local item
	if ! item=$(resolve_input "$1"); then
		if [[ $MODE == tmux ]]; then
			printf 'No directory found.\n'
			return 1
		fi
		item=$1
	fi
	open_selection "$item"
}

run_picker() {
	local output key item
	while true; do
		output=$(show_picker) || return 0
		key=''; item=$output
		if [[ $MODE_LOCKED == false ]]; then
			key=${output%%$'\n'*}
			item=${output#*$'\n'}
		fi
		if [[ $key == ctrl-g && $MODE_LOCKED == false ]]; then
			if [[ $MODE == herdr ]]; then MODE=tmux; else MODE=herdr; fi
			load_backend
			continue
		fi
		[[ -n $item ]] || return 0
		open_selection "$item"
		return $?
	done
}

case ${1:-} in
-h | --help) show_help; exit 0 ;;
-r | --repo) printf 'Repository cloning (-r/--repo) is not supported.\n' >&2; exit 1 ;;
esac

MODE=herdr
MODE_LOCKED=false
if [[ -n $TMUX ]]; then MODE=tmux; MODE_LOCKED=true; fi
load_backend
if [[ $# -gt 0 ]]; then open_input "$1"; else run_picker; fi
